# No passwords belong in this file. Windows setup writes its own .env.
GEP_IMAGE=gep:0.1.1
GEP_PROJECT_NAME=gep
GEP_VOLUME=gep_data
GEP_EXPECTED_INSTANCE=
GEP_SETUP_ENABLED=1
GEP_BIND_ADDRESS=127.0.0.1
GEP_PORT=8080
GEP_ADMIN_HOST=admin.localhost
GEP_EXPERIMENT_HOST=experiment.localhost
GEP_WWW_HOST=www.localhost
GEP_ADMIN_ORIGIN=http://admin.localhost:8080
GEP_PUBLIC_API=http://experiment.localhost:8080
GEP_HTTPS=0
# Optional, used only when explicitly switching to compose.public.yaml.
GEP_CADDY_IMAGE=gep-caddy:2.11.7-go1.26.10
GEP_BASE_DOMAIN=
