extends SceneTree
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var backend = load("res://addons/gec/native_backend.gd").new()
	backend.config = JSON.parse_string(FileAccess.get_file_as_string(OS.get_environment("GEP_TEST_CONFIG")))
	root.add_child(backend)
	var options = JSON.parse_string(FileAccess.get_file_as_string(OS.get_environment("GEP_TEST_RECOVERY")))
	var invalid = options.duplicate(true); invalid.permit = "invalid-synthetic-permit"
	assert((await backend.prepare(invalid)).has("error"))
	assert(backend.read_session(options.recovery_session).paused)
	var result = await backend.prepare(options)
	backend.timer.stop()
	assert(result.state == "data_only" and result.checkpoint == null)
	var saved = backend.read_session(backend.session_id)
	assert(not saved.get("paused",false),"Authorized recovery must unpause the old upload queue")
	assert(saved.get("attempts",0) == 0 and saved.get("retry_at",0) == 0)
	var exported = await backend.recovery_export()
	assert(exported.records.size() == 2 and saved.segments.size() == 1)
	assert(not exported.has("proof") and not exported.has("context"))
	assert((await backend.record("exp.rt",{},{})).has("error"))
	await backend.flush()
	saved = backend.read_session(backend.session_id)
	if exported.completion != null: assert(saved.kind == "cleaned")
	else: assert(saved.pending.is_empty() and saved.records.size() == 2 and saved.checkpoint != null)
	print("NATIVE_DATA_ONLY_RECOVERY_VERIFIED"); quit()
